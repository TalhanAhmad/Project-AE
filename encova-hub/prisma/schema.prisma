generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum UserRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

model User {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authSubject   String              @unique @map("auth_subject") @db.VarChar(191)
  email         String              @unique @db.VarChar(254)
  name          String              @db.VarChar(120)
  role          UserRole            @default(MEMBER)
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  credential    CredentialIdentity?
  memberships   ProjectMember[]
  assignedTasks Task[]              @relation("TaskAssignee")
  createdTasks  Task[]              @relation("TaskCreator")
  comments      Comment[]
  activityLogs  ActivityLog[]

  @@map("users")
}

model CredentialIdentity {
  subject      String   @id @db.VarChar(191)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  userId       String   @unique @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("credential_identities")
}

model Client {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(120)
  email      String?   @db.VarChar(254)
  company    String?   @db.VarChar(120)
  notes      String?   @db.VarChar(5000)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  projects   Project[]

  @@map("clients")
}

model Project {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String             @map("client_id") @db.Uuid
  name         String             @db.VarChar(120)
  description  String?            @db.VarChar(5000)
  status       ProjectStatus      @default(PLANNED)
  dueDate      DateTime?          @map("due_date") @db.Date
  archivedAt   DateTime?          @map("archived_at") @db.Timestamptz(3)
  version      Int                @default(1)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members      ProjectMember[]
  tasks        Task[]
  milestones   ProjectMilestone[]
  activityLogs ActivityLog[]

  @@index([clientId])
  @@map("projects")
}

model Task {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String            @map("project_id") @db.Uuid
  title        String            @db.VarChar(200)
  description  String?           @db.VarChar(5000)
  status       TaskStatus        @default(TODO)
  priority     TaskPriority      @default(MEDIUM)
  assigneeId   String?           @map("assignee_id") @db.Uuid
  milestoneId  String?           @map("milestone_id") @db.Uuid
  dueDate      DateTime?         @map("due_date") @db.Date
  createdById  String            @map("created_by") @db.Uuid
  version      Int               @default(1)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignee     User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  milestone    ProjectMilestone? @relation("TaskMilestone", fields: [milestoneId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User              @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  comments     Comment[]
  activityLogs ActivityLog[]     @relation("TaskActivity")

  @@unique([id, projectId])
  @@index([projectId, status, createdAt, id])
  @@index([projectId, deletedAt, dueDate, createdAt(sort: Desc), id(sort: Desc)], map: "tasks_project_visible_due_created_id_idx")
  @@index([assigneeId, dueDate])
  @@map("tasks")
}

model ProjectMilestone {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String          @map("project_id") @db.Uuid
  title     String          @db.VarChar(200)
  dueDate   DateTime?       @map("due_date") @db.Date
  status    MilestoneStatus @default(PLANNED)
  version   Int             @default(1)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tasks     Task[]          @relation("TaskMilestone")

  @@unique([id, projectId])
  @@index([projectId, status, dueDate])
  @@map("project_milestones")
}

model Comment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String    @db.VarChar(2000)
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([taskId, createdAt, id])
  @@map("comments")
}

model ProjectMember {
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([projectId, userId])
  @@index([userId, projectId])
  @@map("project_members")
}

model ActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  taskId    String?  @map("task_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String   @db.VarChar(80)
  details   Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  task      Task?    @relation("TaskActivity", fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Restrict)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([projectId, createdAt, id])
  @@map("activity_logs")
}
