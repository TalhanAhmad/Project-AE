# Copy to .env. Replace placeholders; never commit real credentials.
# The optional Windows db:setup script writes a local .env with random passwords.
APP_ORIGIN="http://127.0.0.1:3000"
AUTH_SECRET="replace-with-a-random-32-byte-secret"
DATABASE_URL="postgresql://encova_app:REPLACE_ME@127.0.0.1:55432/encova_hub"
MIGRATION_DATABASE_URL="postgresql://encova_migrate:REPLACE_ME@127.0.0.1:55432/encova_hub"
# Managed Neon deployments supply DATABASE_URL_UNPOOLED instead of this local-only URL.
TEST_DATABASE_URL="postgresql://encova_test:REPLACE_ME@127.0.0.1:55432/encova_hub_test"
# Set these only while running `pnpm auth:seed-owner`; do not commit them.
AUTH_BOOTSTRAP_OWNER_EMAIL="owner@example.test"
AUTH_BOOTSTRAP_OWNER_NAME="Example Owner"
AUTH_BOOTSTRAP_OWNER_PASSWORD="replace-with-a-long-unique-password"
# Use these only with `pnpm auth:seed-member`; members are created manually.
AUTH_BOOTSTRAP_MEMBER_EMAIL="member@example.test"
AUTH_BOOTSTRAP_MEMBER_NAME="Example Member"
AUTH_BOOTSTRAP_MEMBER_PASSWORD="replace-with-a-long-unique-password"
