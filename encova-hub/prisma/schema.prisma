generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum UserRole {
  OWNER
  MEMBER
}

model User {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authSubject String               @unique @map("auth_subject") @db.VarChar(191)
  email       String               @unique @db.VarChar(254)
  name        String               @db.VarChar(120)
  role        UserRole             @default(MEMBER)
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  credential  CredentialIdentity?
  memberships ProjectMember[]

  @@map("users")
}

model CredentialIdentity {
  subject      String   @id @db.VarChar(191)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  userId       String   @unique @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("credential_identities")
}

model Client {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(120)
  email      String?   @db.VarChar(254)
  company    String?   @db.VarChar(120)
  notes      String?   @db.VarChar(5000)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  projects   Project[]

  @@map("clients")
}

model Project {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String        @map("client_id") @db.Uuid
  name        String        @db.VarChar(120)
  description String?       @db.VarChar(5000)
  status      ProjectStatus @default(PLANNED)
  dueDate     DateTime?      @map("due_date") @db.Date
  archivedAt  DateTime?      @map("archived_at") @db.Timestamptz(3)
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members     ProjectMember[]

  @@index([clientId])
  @@map("projects")
}

model ProjectMember {
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([projectId, userId])
  @@index([userId, projectId])
  @@map("project_members")
}
