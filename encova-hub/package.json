{
  "name": "encova-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node --conditions=react-server scripts/seed-owner-on-deploy.mts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --test learning/day-02.test.mts tests/clients.test.mts tests/create-clients.test.mts tests/projects.test.mts tests/database-url.test.mts tests/auth-policy.test.mts tests/logger.test.mts",
    "test:http": "node --test --test-concurrency=1 tests/clients.http.test.mts tests/projects.http.test.mts tests/health.http.test.mts",
    "test:browser": "playwright test",
    "test:integration": "node --conditions=react-server --test tests/database.integration.test.mts",
    "practice:day2": "node learning/day-02.mts",
    "db:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 setup",
    "db:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 start",
    "db:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 stop",
    "db:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 status",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.mts",
    "db:seed": "prisma db seed",
    "auth:seed-owner": "node --conditions=react-server scripts/seed-owner.mts",
    "auth:seed-member": "node --conditions=react-server scripts/seed-member.mts",
    "db:join": "node scripts/join.mts",
    "db:verify-recreation": "node scripts/verify-recreation.mts",
    "db:analyze-task-workspace": "node scripts/analyze-task-workspace-query.mts",
    "db:verify-local-restore": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-local-restore.ps1",
    "persistence:create": "node scripts/verify-persistence.mts create",
    "persistence:check": "node scripts/verify-persistence.mts check",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.8",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.9"
    }
  },
  "packageManager": "pnpm@10.34.7"
}
